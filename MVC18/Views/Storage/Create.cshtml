@model MVC18.DTOs.Products.Create.CreateStorageDTO
@{
    ViewData["Title"] = "Thêm Storage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="container" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Thêm Storage</h2>
            <a asp-action="Products" asp-controller="Manager" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" asp-controller="Storage" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 border-end pe-4">
                            <h5 class="text-primary mb-4 pb-2 border-bottom">Thông tin Chung</h5>

                            <div class="mb-3">
                                <label asp-for="ProductName" class="form-label fw-medium">Tên Sản phẩm *</label>
                                <input asp-for="ProductName" type="text" class="form-control" />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CategoryId" class="form-label fw-medium">Category ID *</label>
                                <select asp-for="CategoryId" class="form-control">
                                    <option value="">-- Chọn Danh mục --</option>
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Value">@category.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label fw-medium">Company ID *</label>
                                <select asp-for="SupplierId" class="form-control">
                                    <option value="">-- Chọn Công ty --</option>
                                    @foreach (var supplier in ViewBag.Suppliers)
                                    {
                                        <option value="@supplier.Value">@supplier.Text</option>
                                    }
                                </select> 
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-medium">URL Hình ảnh *</label>
                                <input asp-for="ImageUrl" type="text" class="form-control" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-medium">Giá bán *</label>
                                <input asp-for="UnitPrice" type="number" class="form-control" step="0.01" />
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitsInStock" class="form-label fw-medium">Tồn kho *</label>
                                <input asp-for="UnitsInStock" type="number" class="form-control" />
                                <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-medium">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                        </div>
                        <div class="col-md-6 ps-4">
                            <h5 class="text-success mb-4 pb-2 border-bottom">Thông số Kỹ thuật</h5>

                            <div class="mb-3">
                                <label asp-for="Capacity" class="form-label fw-medium">Dung lượng (GB) *</label>
                                <input asp-for="Capacity" type="number" class="form-control" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MemoryType" class="form-label fw-medium">Loại bộ nhớ *</label>
                                <input asp-for="MemoryType" type="text" class="form-control" />
                                <span asp-validation-for="MemoryType" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="InterfaceType" class="form-label fw-medium">Loại giao tiếp *</label>
                                <input asp-for="InterfaceType" type="text" class="form-control" />
                                <span asp-validation-for="InterfaceType" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReadSpeed" class="form-label fw-medium">Tốc độ đọc (MB/s) *</label>
                                <input asp-for="ReadSpeed" type="number" class="form-control" />
                                <span asp-validation-for="ReadSpeed" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="WriteSpeed" class="form-label fw-medium">Tốc độ ghi (MB/s) *</label>
                                <input asp-for="WriteSpeed" type="number" class="form-control" />
                                <span asp-validation-for="WriteSpeed" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-2"></i>Lưu Sản phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
