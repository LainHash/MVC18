@{
    var jwt = Context.Request.Cookies["jwt"];

    var username = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<!-- Navbar & Hero Start -->
<div class="container-fluid nav-bar sticky-top px-0 px-lg-4 py-2 py-lg-0">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand p-0">
                <h1 class="display-6 text-primary"><i class="fas fa-laptop me-3"></i>TechStore</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav mx-auto py-0">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-item nav-link">
                        Trang chủ
                    </a>
                    <a asp-controller="Home"
                       asp-action="About"
                       class="nav-item nav-link">
                        Giới thiệu
                    </a>
                    @await Component.InvokeAsync("ProductNavbar")
                    <div class="nav-item dropdown">
                        <a href="#"
                           class="nav-link dropdown-toggle"
                           data-bs-toggle="dropdown">
                            Trang khác
                        </a>
                        <div class="dropdown-menu rounded-0 m-0">
                            <a asp-controller="Home"
                               asp-action="Team"
                               class="dropdown-item">
                                Đội ngũ
                            </a>
                            <a asp-controller="Home"
                               asp-action="Blog"
                               class="dropdown-item">
                                Tin tức
                            </a>
                        </div>
                    </div>
                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="nav-item nav-link">
                        Liên hệ
                    </a>
                </div>
                @if (username != null)
                {
                    <div class="nav-item dropdown">
                        <a asp-controller="Auth"
                           asp-action="Details"
                           asp-route-role="@role"
                           class="nav-link dropdown-toggle">
                            xin chào, @username
                        </a>
                        <div class="dropdown-menu rounded-0 m-0">
                            @* <a asp-controller="Customer"
                               asp-action="Index"
                               class="dropdown-item">
                                Tài khoản
                            </a> *@
                            <a asp-controller="Account"
                               asp-action="Logout"
                               class="dropdown-item">
                                Đăng xuất
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-primary rounded-pill py-2 px-4 me-2">
                        Đăng nhập
                    </a>
                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-outline-primary rounded-pill py-2 px-4">
                        Đăng ký
                    </a>
                }
            </div>
        </nav>
    </div>
</div>
<!-- Navbar & Hero End -->