@model MVC18.DTOs.Products.Create.CreateLaptopDTO

<form asp-action="Create" asp-controller="Laptop" method="post" id="createLaptopForm">
    @Html.AntiForgeryToken()
    
    <div class="row">
        <!-- Thông tin chung -->
        <div class="col-md-6">
            <h6 class="mb-3 text-primary border-bottom pb-2">Thông tin Chung</h6>
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">Tên Sản phẩm <span class="text-danger">*</span></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger small"></span>
            </div>
            
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="CategoryId" class="form-label">Category ID <span class="text-danger">*</span></label>
                    <input asp-for="CategoryId" type="number" class="form-control" />
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    <small class="text-muted">Tạm nhập ID (vd: 1)</small>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="SupplierId" class="form-label">Company ID <span class="text-danger">*</span></label>
                    <input asp-for="SupplierId" type="number" class="form-control" />
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    <small class="text-muted">Tạm nhập ID (vd: 1)</small>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">URL Hình ảnh <span class="text-danger">*</span></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="UnitPrice" class="form-label">Giá bán <span class="text-danger">*</span></label>
                    <input asp-for="UnitPrice" type="number" class="form-control" />
                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="UnitsInStock" class="form-label">Tồn kho <span class="text-danger">*</span></label>
                    <input asp-for="UnitsInStock" type="number" class="form-control" />
                    <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <!-- Cấu hình Laptop -->
        <div class="col-md-6">
            <h6 class="mb-3 text-success border-bottom pb-2">Cấu hình Laptop</h6>
            
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="LaptopType" class="form-label">Loại Laptop <span class="text-danger">*</span></label>
                    <input asp-for="LaptopType" class="form-control" placeholder="Gaming, Văn phòng..." />
                    <span asp-validation-for="LaptopType" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Os" class="form-label">Hệ điều hành <span class="text-danger">*</span></label>
                    <input asp-for="Os" class="form-control" placeholder="Windows 11..." />
                    <span asp-validation-for="Os" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ScreenResolution" class="form-label">Độ phân giải màn hình <span class="text-danger">*</span></label>
                <input asp-for="ScreenResolution" class="form-control" placeholder="1920x1080..." />
                <span asp-validation-for="ScreenResolution" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Length" class="form-label">Kích thước (inch) <span class="text-danger">*</span></label>
                    <input asp-for="Length" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Length" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Weight" class="form-label">Trọng lượng (kg) <span class="text-danger">*</span></label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Weight" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="CpuId" class="form-label">CPU ID <span class="text-danger">*</span></label>
                    <input asp-for="CpuId" type="number" class="form-control" />
                    <span asp-validation-for="CpuId" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="GpuId" class="form-label">GPU ID <span class="text-danger">*</span></label>
                    <input asp-for="GpuId" type="number" class="form-control" />
                    <span asp-validation-for="GpuId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="RamId" class="form-label">RAM ID <span class="text-danger">*</span></label>
                    <input asp-for="RamId" type="number" class="form-control" />
                    <span asp-validation-for="RamId" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="StorageId" class="form-label">Storage ID <span class="text-danger">*</span></label>
                    <input asp-for="StorageId" type="number" class="form-control" />
                    <span asp-validation-for="StorageId" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>
    
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="d-flex justify-content-end mt-3 border-top pt-3">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary">Lưu Sản phẩm</button>
    </div>
</form>

<!-- Tích hợp validation script phía client cho PartialView -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
