@using MVC18.Helpers.Constants.Misc
@model MVC18.ResultModels.Misc.PagedResult<MVC18.DTOs.Products.ProductDTO>

@{
    ViewData["Title"] = "Sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var query = Context.Request.Query;
}

<!-- Header Start -->
<div class="container-fluid bg-breadcrumb mb-5">
    <div class="container text-center py-5" style="max-width: 900px;">
        <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Sản phẩm của chúng tôi</h4>
        <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active text-primary">Sản phẩm</li>
        </ol>    
    </div>
</div>
<!-- Header End -->

<!-- Filter Section -->
<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <form id="filterForm" class="row g-3">
                <div class="col-md-3">
                    <input type="text" 
                        name="Keyword" 
                        class="form-control" 
                        placeholder="Tìm kiếm sản phẩm..." 
                        value="@Context.Request.Query["Keyword"]" onchange="this.form.submit()">
                </div>
                <div class="col-md-3">
                    <select name="CategoryName" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả danh mục</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var item in ViewBag.Categories)
                            {
                                <option value="@item.CategoryName" selected="@(query["CategoryName"] == item.CategoryName)">@item.CategoryName (@item.Count)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="CompanyName" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả nhà cung cấp</option>
                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var item in ViewBag.Suppliers)
                            {
                                <option value="@item.CompanyName" selected="@(query["CompanyName"] == item.CompanyName)">@item.CompanyName (@item.Count)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="SortBy" class="form-select" onchange="this.form.submit()">
                        @if (ViewBag.SortBys != null)
                        {
                            foreach (var item in ViewBag.SortBys)
                            {
                                <option value="@item.Value" selected="@(query["SortBy"] == item.Value)">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <input type="hidden" name="Page" id="pageInput" value="1" />
            </form>
        </div>
    </div>

    <div id="productGridContainer">
        @await Html.PartialAsync("_ProductGrid", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            function loadProducts(url) {
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (result) {
                        $('#productGridContainer').html(result);
                        
                        $('html, body').animate({
                            scrollTop: $('#filterForm').offset().top - 100
                        }, 500);
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi khi tải dữ liệu sản phẩm.');
                    }
                });
            }

            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                $('#pageInput').val(1); 
                
                var queryParams = $(this).serialize();
                var url = '@Url.Action("Index", "Product")' + '?' + queryParams;
                
                loadProducts(url);
                
                window.history.pushState({path: url}, '', url);
            });

            $(document).on('click', '.pagination-link', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                
                if (page) {
                    $('#pageInput').val(page);
                    var queryParams = $('#filterForm').serialize();
                    var url = '@Url.Action("Index", "Product")' + '?' + queryParams;
                    
                    loadProducts(url);
                    
                    window.history.pushState({path: url}, '', url);
                }
            });

            $(window).on('popstate', function () {
                loadProducts(location.href);
            });
        });
    </script>
}