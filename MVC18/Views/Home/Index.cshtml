@{
    ViewData["Title"] = "Home Page";
}

<!-- Carousel Start -->
<div class="header-carousel mb-5">
    <div id="carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="false">
        <ol class="carousel-indicators">
            <li data-bs-target="#carouselId" data-bs-slide-to="0" class="active" aria-current="true" aria-label="First slide"></li>
            <li data-bs-target="#carouselId" data-bs-slide-to="1" aria-label="Second slide"></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="carousel-item active">
                <img src="~/img/carousel-2.jpg" class="img-fluid w-100" alt="First slide"/>
                <div class="carousel-caption">
                    <div class="container py-4">
                        <div class="row g-5">
                            <div class="col-lg-6 fadeInLeft animated" data-animation="fadeInLeft" data-delay="1s" style="animation-delay: 1s;">
                                <div class="bg-secondary rounded p-5 text-center">
                                    <h4 class="text-white mb-4">LAPTOP MỚI NHẤT</h4>
                                    <p class="text-white">Khám phá bộ sưu tập laptop hiệu năng cao mới nhất dành cho chơi game và làm việc.</p>
                                    <a asp-controller="Laptop" asp-action="Index" class="btn btn-primary rounded-pill py-2 px-4 mt-3">Mua Laptop</a>
                                </div>
                            </div>
                            <div class="col-lg-6 d-none d-lg-flex fadeInRight animated" data-animation="fadeInRight" data-delay="1s" style="animation-delay: 1s;">
                                <div class="text-start">
                                    <h1 class="display-5 text-white">Nâng cấp cấu hình của bạn ngay hôm nay</h1>
                                    <p>Giảm đến 15% cho một số linh kiện được chọn.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/img/carousel-1.jpg" class="img-fluid w-100" alt="Second slide"/>
                <div class="carousel-caption">
                    <div class="container py-4">
                        <div class="row g-5">
                            <div class="col-lg-6 fadeInLeft animated" data-animation="fadeInLeft" data-delay="1s" style="animation-delay: 1s;">
                                <div class="bg-secondary rounded p-5 text-center">
                                    <h4 class="text-white mb-4">LINH KIỆN PC</h4>
                                    <p class="text-white">Xây dựng cỗ máy trong mơ với các CPU, GPU và bo mạch chủ mới nhất.</p>
                                    <a asp-controller="Cpu" asp-action="Index" class="btn btn-primary rounded-pill py-2 px-4 mt-3">Mua Linh Kiện</a>
                                </div>
                            </div>
                            <div class="col-lg-6 d-none d-lg-flex fadeInRight animated" data-animation="fadeInRight" data-delay="1s" style="animation-delay: 1s;">
                                <div class="text-start">
                                    <h1 class="display-5 text-white">Hiệu năng Đỉnh cao</h1>
                                    <p>Trải nghiệm sức mạnh tối thượng với phần cứng thế hệ mới.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Carousel End -->

<!-- About Start -->
<div class="container-fluid overflow-hidden about py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-xl-6 wow fadeInLeft" data-wow-delay="0.2s">
                <div class="about-item">
                    <div class="pb-5">
                        <h1 class="display-5 text-capitalize">Về <span class="text-primary">TechStore</span></h1>
                        <p class="mb-0">Chúng tôi là nhà cung cấp hàng đầu về laptop và linh kiện PC chất lượng cao. Dù bạn là game thủ, nhà sáng tạo hay dân chuyên nghiệp, chúng tôi đều có phần cứng phù hợp cho bạn.
                        </p>
                    </div>
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="about-item-inner border p-4">
                                <div class="about-icon mb-4">
                                    <i class="fas fa-microchip fa-3x text-primary"></i>
                                </div>
                                <h5 class="mb-3">Chất lượng cao cấp</h5>
                                <p class="mb-0">Chúng tôi chỉ cung cấp những sản phẩm tốt nhất từ các thương hiệu hàng đầu.</p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="about-item-inner border p-4">
                                <div class="about-icon mb-4">
                                    <i class="fas fa-headset fa-3x text-primary"></i>
                                </div>
                                <h5 class="mb-3">Hỗ trợ chuyên nghiệp</h5>
                                <p class="mb-0">Đội ngũ của chúng tôi luôn sẵn sàng hỗ trợ bạn xây dựng cấu hình hoàn hảo nhất.</p>
                            </div>
                        </div>
                    </div>
                    <p class="text-item my-4">Niềm đam mê công nghệ thúc đẩy chúng tôi mang đến trải nghiệm khách hàng tốt nhất có thể. Hãy để chúng tôi chắp cánh cho cuộc phiêu lưu kỹ thuật số tiếp theo của bạn.
                    </p>
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="text-center rounded bg-secondary p-4">
                                <h1 class="display-6 text-white">10</h1>
                                <h5 class="text-light mb-0">Năm kinh nghiệm</h5>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="rounded">
                                <p class="mb-2"><i class="fa fa-check-circle text-primary me-1"></i> Đại lý ủy quyền</p>
                                <p class="mb-2"><i class="fa fa-check-circle text-primary me-1"></i> Giao hàng nhanh chóng</p>
                                <p class="mb-2"><i class="fa fa-check-circle text-primary me-1"></i> Thanh toán an toàn</p>
                                <p class="mb-0"><i class="fa fa-check-circle text-primary me-1"></i> Hỗ trợ 24/7</p>
                            </div>
                        </div>
                        <div class="col-lg-5 d-flex align-items-center">
                            <a asp-controller="Home" asp-action="About" class="btn btn-primary rounded py-3 px-5">Tìm hiểu thêm</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 wow fadeInRight" data-wow-delay="0.2s">
                <div class="about-img">
                    <div class="img-1">
                        <img src="~/img/about-img.jpg" class="img-fluid rounded h-100 w-100" alt="">
                    </div>
                    <div class="img-2">
                        <img src="~/img/about-img-1.jpg" class="img-fluid rounded w-100" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->

<!-- Product categories Start -->
<div class="container-fluid categories py-5">
    <div class="container">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 800px;">
            <h1 class="display-5 text-capitalize mb-3">Sản Phẩm <span class="text-primary">Nổi Bật</span></h1>
            <p class="mb-0">Xem qua các laptop và linh kiện bán chạy nhất của chúng tôi.
            </p>
        </div>
        <div class="categories-carousel owl-carousel wow fadeInUp" data-wow-delay="0.1s">
            <!-- Product Item 1 -->
            <div class="categories-item p-4">
                <div class="categories-item-inner">
                    <div class="categories-img rounded-top">
                        <img src="~/img/car-1.png" class="img-fluid w-100 rounded-top" alt="">
                    </div>
                    <div class="categories-content rounded-bottom p-4">
                        <h4>Asus ROG Strix</h4>
                        <div class="categories-review mb-4">
                            <div class="me-3">4.5 Đánh giá</div>
                            <div class="d-flex justify-content-center text-secondary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star text-body"></i>
                            </div>
                        </div>
                        <div class="mb-4">
                            <h4 class="bg-white text-primary rounded-pill py-2 px-4 mb-0">$1499.00</h4>
                        </div>
                        <div class="row gy-2 gx-0 text-center mb-4">
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-microchip text-dark"></i> <span class="text-body ms-1">Core i9</span>
                            </div>
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-memory text-dark"></i> <span class="text-body ms-1">32GB</span>
                            </div>
                            <div class="col-4">
                                <i class="fas fa-hdd text-dark"></i> <span class="text-body ms-1">1TB SSD</span>
                            </div>
                        </div>
                        <a href="#" class="btn btn-primary rounded-pill d-flex justify-content-center py-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>
            <!-- Product Item 2 -->
            <div class="categories-item p-4">
                <div class="categories-item-inner">
                    <div class="categories-img rounded-top">
                        <img src="~/img/car-2.png" class="img-fluid w-100 rounded-top" alt="">
                    </div>
                    <div class="categories-content rounded-bottom p-4">
                        <h4>MSI GeForce RTX 4090</h4>
                        <div class="categories-review mb-4">
                            <div class="me-3">5.0 Đánh giá</div>
                            <div class="d-flex justify-content-center text-secondary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                        <div class="mb-4">
                            <h4 class="bg-white text-primary rounded-pill py-2 px-4 mb-0">$1599.00</h4>
                        </div>
                        <div class="row gy-2 gx-0 text-center mb-4">
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-memory text-dark"></i> <span class="text-body ms-1">24GB VRAM</span>
                            </div>
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-bolt text-dark"></i> <span class="text-body ms-1">PCIe 4.0</span>
                            </div>
                            <div class="col-4">
                                <i class="fas fa-fan text-dark"></i> <span class="text-body ms-1">Triple Fan</span>
                            </div>
                        </div>
                        <a href="#" class="btn btn-primary rounded-pill d-flex justify-content-center py-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>
            <!-- Product Item 3 -->
            <div class="categories-item p-4">
                <div class="categories-item-inner">
                    <div class="categories-img rounded-top">
                        <img src="~/img/car-3.png" class="img-fluid w-100 rounded-top" alt="">
                    </div>
                    <div class="categories-content rounded-bottom p-4">
                        <h4>Intel Core i9-14900K</h4>
                        <div class="categories-review mb-4">
                            <div class="me-3">4.8 Đánh giá</div>
                            <div class="d-flex justify-content-center text-secondary">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star text-body"></i>
                            </div>
                        </div>
                        <div class="mb-4">
                            <h4 class="bg-white text-primary rounded-pill py-2 px-4 mb-0">$589.00</h4>
                        </div>
                        <div class="row gy-2 gx-0 text-center mb-4">
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-microchip text-dark"></i> <span class="text-body ms-1">24 Cores</span>
                            </div>
                            <div class="col-4 border-end border-white">
                                <i class="fas fa-tachometer-alt text-dark"></i> <span class="text-body ms-1">6.0 GHz</span>
                            </div>
                            <div class="col-4">
                                <i class="fas fa-memory text-dark"></i> <span class="text-body ms-1">DDR5</span>
                            </div>
                        </div>
                        <a href="#" class="btn btn-primary rounded-pill d-flex justify-content-center py-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Product categories End -->
