@model MVC18.DTOs.Users.Update.UpdateProfileDTO

@{
    ViewData["Title"] = "Cập nhật hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header Start -->
<div class="container-fluid bg-breadcrumb mb-5">
    <div class="container text-center py-5" style="max-width: 900px;">
        <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Cập nhật hồ sơ Nhân viên</h4>
        <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Employee" asp-action="Index">Nhân viên</a></li>
            <li class="breadcrumb-item active text-primary">Cập nhật hồ sơ</li>
        </ol>    
    </div>
</div>
<!-- Header End -->

<div class="container py-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-0">
                    <div class="list-group list-group-flush rounded">
                        <a asp-action="Index" class="list-group-item list-group-item-action fw-bold border-0 rounded-top">
                            <i class="fas fa-home me-2 w-20px"></i> Bảng điều khiển
                        </a>
                        <a asp-action="Details" class="list-group-item list-group-item-action fw-bold border-0">
                            <i class="fas fa-user-tie me-2 w-20px"></i> Hồ sơ nhân viên
                        </a>
                        <a asp-action="UpdateProfile" class="list-group-item list-group-item-action active fw-bold border-0">
                            <i class="fas fa-edit me-2 w-20px"></i> Chỉnh sửa hồ sơ
                        </a>
                        <a asp-action="ChangePassword" class="list-group-item list-group-item-action fw-bold border-0">
                            <i class="fas fa-key me-2 w-20px"></i> Đổi mật khẩu
                        </a>
                        <a asp-action="ChangeEmail" class="list-group-item list-group-item-action fw-bold border-0 rounded-bottom">
                            <i class="fas fa-envelope me-2 w-20px"></i> Đổi email
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0">Chỉnh sửa thông tin cá nhân</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="UpdateProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập *</label>
                                <input asp-for="Username" class="form-control" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold">Họ *</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold">Tên *</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-bold">Giới tính</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Dob" class="form-label fw-bold">Ngày sinh *</label>
                                <input asp-for="Dob" type="date" class="form-control" />
                                <span asp-validation-for="Dob" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold">Số điện thoại *</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CitizenIdentityCard" class="form-label fw-bold">Số CCCD/CMND *</label>
                                <input asp-for="CitizenIdentityCard" class="form-control" />
                                <span asp-validation-for="CitizenIdentityCard" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-bold">Thành phố *</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Country" class="form-label fw-bold">Quốc gia *</label>
                                <input asp-for="Country" class="form-control" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold">Địa chỉ chi tiết *</label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                            <a asp-action="Details" class="btn btn-light rounded-pill px-4 me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .w-20px { width: 20px; text-align: center; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
