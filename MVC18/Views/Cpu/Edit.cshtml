@model MVC18.DTOs.Products.Update.UpdateCpuDTO
@{
    ViewData["Title"] = "Sửa Cpu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedSupplierId = Model.SupplierId;
}

<div class="container-fluid py-4">
    <div class="container" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Sửa Cpu</h2>
            <a asp-action="Products" asp-controller="Manager" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-controller="Cpu" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="CategoryId" type="hidden" />

                    <div class="row">
                        <div class="col-md-6 border-end pe-4">
                            <h5 class="text-primary mb-4 pb-2 border-bottom">Thông tin Chung</h5>

                            <div class="mb-3">
                                <label asp-for="ProductName" class="form-label fw-medium">Tên Sản phẩm *</label>
                                <input asp-for="ProductName" type="text" class="form-control" />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label fw-medium">Company ID *</label>
                                <select asp-for="SupplierId" class="form-control">
                                    <option value="">-- Chọn Nhà cung cấp --</option>
                                    @foreach (var supplier in ViewBag.Suppliers)
                                    {
                                        <option value="@supplier.Value"
                                                selected="@(supplier.Value == selectedSupplierId.ToString())">
                                            @supplier.Text
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-medium">URL Hình ảnh *</label>
                                <input asp-for="ImageUrl" type="text" class="form-control" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-medium">Giá bán *</label>
                                <input asp-for="UnitPrice" type="number" class="form-control" step="0.01" />
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitsInStock" class="form-label fw-medium">Tồn kho *</label>
                                <input asp-for="UnitsInStock" type="number" class="form-control" />
                                <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-medium">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                        </div>
                        <div class="col-md-6 ps-4">
                            <h5 class="text-success mb-4 pb-2 border-bottom">Thông số Kỹ thuật</h5>

                            <div class="mb-3">
                                <label asp-for="Cores" class="form-label fw-medium">Số nhân *</label>
                                <input asp-for="Cores" type="number" class="form-control" />
                                <span asp-validation-for="Cores" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Logicals" class="form-label fw-medium">Số luồng *</label>
                                <input asp-for="Logicals" type="number" class="form-control" />
                                <span asp-validation-for="Logicals" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Tdp" class="form-label fw-medium">TDP (W) *</label>
                                <input asp-for="Tdp" type="number" class="form-control" step="0.1" />
                                <span asp-validation-for="Tdp" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Socket" class="form-label fw-medium">Socket *</label>
                                <input asp-for="Socket" type="text" class="form-control" />
                                <span asp-validation-for="Socket" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Speed" class="form-label fw-medium">Tốc độ xung nhịp (MHz) *</label>
                                <input asp-for="Speed" type="number" class="form-control" />
                                <span asp-validation-for="Speed" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Turbo" class="form-label fw-medium">Tốc độ Turbo (MHz) *</label>
                                <input asp-for="Turbo" type="number" class="form-control" />
                                <span asp-validation-for="Turbo" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
