@model MVC18.DTOs.Products.Update.UpdateGpuDTO
@{
    ViewData["Title"] = "Sửa Gpu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedSupplierId = Model.SupplierId;
}

<div class="container-fluid py-4">
    <div class="container" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Sửa Gpu</h2>
            <a asp-action="Products" asp-controller="Manager" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-controller="Gpu" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="CategoryId" type="hidden" />

                    <div class="row">
                        <div class="col-md-6 border-end pe-4">
                            <h5 class="text-primary mb-4 pb-2 border-bottom">Thông tin Chung</h5>

                            <div class="mb-3">
                                <label asp-for="ProductName" class="form-label fw-medium">Tên Sản phẩm *</label>
                                <input asp-for="ProductName" type="text" class="form-control" />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label fw-medium">Company ID *</label>
                                <select asp-for="SupplierId" class="form-control">
                                    <option value="">-- Chọn Nhà cung cấp --</option>
                                    @foreach (var supplier in ViewBag.Suppliers)
                                    {
                                        <option value="@supplier.Value"
                                                selected="@(supplier.Value == selectedSupplierId.ToString())">
                                            @supplier.Text
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-medium">URL Hình ảnh *</label>
                                <input asp-for="ImageUrl" type="text" class="form-control" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-medium">Giá bán *</label>
                                <input asp-for="UnitPrice" type="number" class="form-control" step="0.01" />
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnitsInStock" class="form-label fw-medium">Tồn kho *</label>
                                <input asp-for="UnitsInStock" type="number" class="form-control" />
                                <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-medium">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                        </div>
                        <div class="col-md-6 ps-4">
                            <h5 class="text-success mb-4 pb-2 border-bottom">Thông số Kỹ thuật</h5>

                            <div class="mb-3">
                                <label asp-for="MemorySize" class="form-label fw-medium">Dung lượng bộ nhớ (GB) *</label>
                                <input asp-for="MemorySize" type="number" class="form-control" step="0.1" />
                                <span asp-validation-for="MemorySize" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MemoryType" class="form-label fw-medium">Loại bộ nhớ *</label>
                                <input asp-for="MemoryType" type="text" class="form-control" />
                                <span asp-validation-for="MemoryType" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Clock" class="form-label fw-medium">Xung nhịp (MHz) *</label>
                                <input asp-for="Clock" type="number" class="form-control" />
                                <span asp-validation-for="Clock" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UnifiedShader" class="form-label fw-medium">Unified Shader *</label>
                                <input asp-for="UnifiedShader" type="number" class="form-control" />
                                <span asp-validation-for="UnifiedShader" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Tmu" class="form-label fw-medium">TMU *</label>
                                <input asp-for="Tmu" type="number" class="form-control" />
                                <span asp-validation-for="Tmu" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Rop" class="form-label fw-medium">ROP *</label>
                                <input asp-for="Rop" type="number" class="form-control" />
                                <span asp-validation-for="Rop" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Bus" class="form-label fw-medium">Bus *</label>
                                <input asp-for="Bus" type="text" class="form-control" />
                                <span asp-validation-for="Bus" class="text-danger small"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="Igpu" class="form-check-input" type="checkbox" />
                                <label asp-for="Igpu" class="form-check-label fw-medium">iGPU</label>
                                <span asp-validation-for="Igpu" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
